{
  "schemas": {
    "hero": {
      "name": "hero",
      "type": "document",
      "title": "Hero Section",
      "fields": [
        {
          "name": "label",
          "type": "string",
          "title": "Label",
          "description": "Small text above headline (e.g., 'CIVIL ENGINEERING CONSULTANTS')"
        },
        {
          "name": "headline",
          "type": "string",
          "title": "Headline",
          "description": "Main headline (e.g., 'Engineering clarity. Delivered.')"
        },
        {
          "name": "subheadline",
          "type": "text",
          "title": "Subheadline",
          "description": "Supporting text below headline"
        },
        {
          "name": "ctaText",
          "type": "string",
          "title": "CTA Button Text",
          "description": "Primary button text (e.g., 'Explore services')"
        },
        {
          "name": "secondaryCtaText",
          "type": "string",
          "title": "Secondary CTA Text",
          "description": "Link text (e.g., 'View projects')"
        }
      ]
    },
    "services": {
      "name": "services",
      "type": "document",
      "title": "Services Section",
      "fields": [
        {
          "name": "label",
          "type": "string",
          "title": "Label"
        },
        {
          "name": "headline",
          "type": "string",
          "title": "Headline"
        },
        {
          "name": "description",
          "type": "text",
          "title": "Description"
        },
        {
          "name": "items",
          "type": "array",
          "title": "Service Items",
          "of": [
            {
              "type": "object",
              "fields": [
                {
                  "name": "title",
                  "type": "string",
                  "title": "Service Title"
                },
                {
                  "name": "description",
                  "type": "text",
                  "title": "Service Description"
                },
                {
                  "name": "image",
                  "type": "image",
                  "title": "Service Image",
                  "options": {
                    "hotspot": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "stages": {
      "name": "stages",
      "type": "document",
      "title": "Project Stages Section",
      "fields": [
        {
          "name": "label",
          "type": "string",
          "title": "Label"
        },
        {
          "name": "headline",
          "type": "string",
          "title": "Headline"
        },
        {
          "name": "description",
          "type": "text",
          "title": "Description"
        },
        {
          "name": "caption",
          "type": "string",
          "title": "Caption"
        },
        {
          "name": "items",
          "type": "array",
          "title": "Stage Items",
          "of": [
            {
              "type": "object",
              "fields": [
                {
                  "name": "num",
                  "type": "string",
                  "title": "Stage Number"
                },
                {
                  "name": "title",
                  "type": "string",
                  "title": "Stage Title"
                }
              ]
            }
          ]
        }
      ]
    },
    "featuredProject": {
      "name": "featuredProject",
      "type": "document",
      "title": "Featured Project Section",
      "fields": [
        {
          "name": "headline",
          "type": "string",
          "title": "Project Name"
        },
        {
          "name": "subheadline",
          "type": "string",
          "title": "Project Subtitle"
        },
        {
          "name": "client",
          "type": "string",
          "title": "Client"
        },
        {
          "name": "scope",
          "type": "string",
          "title": "Scope"
        },
        {
          "name": "value",
          "type": "string",
          "title": "Project Value"
        },
        {
          "name": "ctaText",
          "type": "string",
          "title": "CTA Text"
        },
        {
          "name": "image",
          "type": "image",
          "title": "Project Image",
          "options": {
            "hotspot": true
          }
        }
      ]
    },
    "about": {
      "name": "about",
      "type": "document",
      "title": "About Section",
      "fields": [
        {
          "name": "label",
          "type": "string",
          "title": "Label"
        },
        {
          "name": "headline",
          "type": "string",
          "title": "Headline"
        },
        {
          "name": "ctaText",
          "type": "string",
          "title": "CTA Text"
        },
        {
          "name": "cards",
          "type": "array",
          "title": "About Cards",
          "of": [
            {
              "type": "object",
              "fields": [
                {
                  "name": "title",
                  "type": "string",
                  "title": "Card Title"
                },
                {
                  "name": "description",
                  "type": "text",
                  "title": "Card Description"
                },
                {
                  "name": "image",
                  "type": "image",
                  "title": "Card Image",
                  "options": {
                    "hotspot": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "projects": {
      "name": "projects",
      "type": "document",
      "title": "Projects Grid Section",
      "fields": [
        {
          "name": "label",
          "type": "string",
          "title": "Label"
        },
        {
          "name": "headline",
          "type": "string",
          "title": "Headline"
        },
        {
          "name": "ctaText",
          "type": "string",
          "title": "CTA Text"
        },
        {
          "name": "items",
          "type": "array",
          "title": "Project Items",
          "of": [
            {
              "type": "object",
              "fields": [
                {
                  "name": "title",
                  "type": "string",
                  "title": "Project Title"
                },
                {
                  "name": "subtitle",
                  "type": "string",
                  "title": "Project Subtitle"
                },
                {
                  "name": "image",
                  "type": "image",
                  "title": "Project Image",
                  "options": {
                    "hotspot": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "contact": {
      "name": "contact",
      "type": "document",
      "title": "Contact Section",
      "fields": [
        {
          "name": "label",
          "type": "string",
          "title": "Label"
        },
        {
          "name": "headline",
          "type": "string",
          "title": "Headline"
        },
        {
          "name": "description",
          "type": "text",
          "title": "Description"
        },
        {
          "name": "email",
          "type": "string",
          "title": "Email Address"
        },
        {
          "name": "phone",
          "type": "string",
          "title": "Phone Number"
        },
        {
          "name": "location",
          "type": "string",
          "title": "Location"
        },
        {
          "name": "ctaText",
          "type": "string",
          "title": "CTA Button Text"
        }
      ]
    }
  }
}
